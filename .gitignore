# your own run's working files
/config.json
/data/*
# the census, winners corpus and facets the product needs (~32 MB); everything else in data/ stays local
!/data/hackathons.jsonl
!/data/hackathons_all.jsonl
!/data/ideas.db
!/data/facets.jsonl
/judge/
*.pyc
__pycache__/
.DS_Store

# large corpora kept locally, not in the repo — see runs/README.md
runs/*/corpus/

# session cookies — waf_fetch.py reads these; never commit them
lib/cookies.txt
cookies.txt

# oh-my-claudecode plugin runtime state
.omc/

# product build
reference/
web/node_modules/
.env
outputs/
